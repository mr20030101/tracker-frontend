# Cloudflare Pages: the same headers vercel.json sets on Vercel. Keep the two in step.
# The Content-Security-Policy here leaves out Vercel's Speed Insights hosts, which only the
# Vercel build loads. Functions (/api/*) get their headers from functions/api/_middleware.ts.

/*
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; frame-ancestors 'self'; worker-src 'self' blob:;script-src 'self' 'wasm-unsafe-eval' 'sha256-fymOgknBhXCw6Eyy8nbgXC69n76Gq5gkBJNSItjSevc=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https://ieovepkcseytccagzedg.supabase.co; connect-src 'self' https://ieovepkcseytccagzedg.supabase.co wss://ieovepkcseytccagzedg.supabase.co; frame-src https://www.canva.com https://docs.google.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/downloads/extension-version.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

/sw.js
  Cache-Control: no-cache
