# Public build settings for production builds (`vite build`), committed so every host builds the
# same site. Only public values belong here: anything VITE_* ends up in the page's JavaScript.
# A variable set in the host's own settings (e.g. Vercel's) takes priority over this file.

# Cloudflare Turnstile site key for the Apply form's human check (src/components/TurnstileWidget.tsx).
# Its secret key is TURNSTILE_SECRET_KEY, set only as a secret on the host.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFWrLyhgYVqpItnI
