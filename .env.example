VITE_SUPABASE_URL=https://ieovepkcseytccagzedg.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-anon-key
# Optional: fixed TURN relay credentials for voice calls, needed when direct calls can't get
# through (e.g. carrier-grade NAT). Not needed with Cloudflare TURN: that goes through the
# turn-credentials edge function (secrets CLOUDFLARE_TURN_KEY_ID / CLOUDFLARE_TURN_API_TOKEN).
# Comma-separate several URLs. From a provider with fixed credentials such as Metered.
# VITE_TURN_URL=turn:relay.example.com:3478,turns:relay.example.com:5349
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Donation page (/donate). Leave a method blank to show it as unavailable.
# GCash: the number donors send to, the account name shown above it, and an optional QR image
# (e.g. put the QR from the GCash app at public/images/donate/gcash-qr.png and use that path).
# VITE_GCASH_NUMBER=0917 123 4567
# VITE_GCASH_NAME=Juan D.
# VITE_GCASH_QR_URL=/images/donate/gcash-qr.png
# PayPal: just the PayPal.Me handle (paypal.me/<handle>).
# VITE_PAYPAL_ME=yourhandle
